Algoritmo ejercicio6
	Definir Num1, Num2, suma, resta Como Entero
	
	Escribir "Ingrese primer numero a sumar y resta"
	leer Num1
	
	Escribir "Ingrese segundo numero a sumar y restar"
	leer Num2
	
	suma = Num1 + Num2 
	Escribir "La suma de los numeros es: ", suma
	
	resta = Num1 - Num2
	Escribir "La resta de los numeros es: ", resta
	
	
FinAlgoritmo
