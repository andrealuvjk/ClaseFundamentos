Algoritmo ejercicio10
	Definir num1, num2 Como Real
	
	Escribir "Ingrese primer numero a comparar"
	leer num1
	
	Escribir "Ingrese segundo numero a comparar"
	Leer num2
	
	Si num1 > num2 Entonces
		escribir "El numero ", num1 " es mayor a ", num2
	SiNo
	   si	num1 < num2 
		   Escribir "el numero ", num2 " es mayor a ", num1
	   SiNo
		   Escribir "Ambos números son iguales (", num1, " = ", num2, ")"
	   FinSi
		   
	FinSi
	
	
	
FinAlgoritmo
